# Copiar a .env (no se sube a git). Valores: Firebase > Configuración del proyecto
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (Firebase Auth: habilitar Google; IDs en Google Cloud)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Opcional para build nativo:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Facebook (App ID de Meta, Auth Facebook habilitado en Firebase)
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Comas o espacios: emails que reciben rol admin al registrarse
EXPO_PUBLIC_ADMIN_EMAILS=admin@correo.unimet.edu.ve

# true = botón de datos demo (solo con perfil admin y sin grupos)
EXPO_PUBLIC_ENABLE_SEED=false

# Misma región que Cloud Functions al desplegar
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
